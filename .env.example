# Qdrant from docker-compose.yml; change for a remote instance.
QDRANT_URL=http://localhost:6333
# Where FastEmbed keeps the downloaded model; defaults to .cache/fastembed in the repository.
# FASTEMBED_CACHE_PATH=.cache/fastembed
# Claude model for the agent; compare alternatives with the eval before changing.
LLM_MODEL=claude-sonnet-5-5
# Needed by the agent only. Put the real key in .env, never in this file.
ANTHROPIC_API_KEY=
# TOP_K=5
# MAX_SEARCHES=3
